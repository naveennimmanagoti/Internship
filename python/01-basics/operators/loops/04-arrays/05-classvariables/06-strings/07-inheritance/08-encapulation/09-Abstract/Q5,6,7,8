from abc import ABC, abstractmethod

class Animal(ABC):

    @abstractmethod
    def sound(self):
        pass

    @abstractmethod
    def eat(self):
        pass


class Dog(Animal):

    def sound(self):
        print("Dog barks")


# Try to create object
d = Dog()